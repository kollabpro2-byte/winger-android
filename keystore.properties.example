# Copy to keystore.properties (gitignored) or provide the same names as env vars
# in CI: WINGER_KS, WINGER_KS_PASS, WINGER_KEY_ALIAS, WINGER_KEY_PASS.
#
# The release keystore must never be committed. Without this file (or env vars)
# assembleRelease produces an unsigned APK, which is exactly what CI must fail on.
storeFile=/absolute/path/to/winger-release.jks
storePassword=change-me
keyAlias=winger
keyPassword=change-me
